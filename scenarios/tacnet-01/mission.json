{
  "scenario_id": "tacnet-01",
  "name": "전술망 대대 기동작전 축약 시나리오",
  "network_type": "tactical",
  "authored": "2026-09-06",
  "classification": "가상. 공개 자료와 일반 교리 수준으로만 구성. 실제 부대편성·임무계획·자산대장 미사용.",
  "basis": "ADR-0012(대상 망은 전술망)가 요구한 시간축을 반영한 첫 시나리오. 정적 시나리오 scenarios/defnet-01 은 단일 스냅샷으로 그대로 둔다.",

  "timeline": {
    "unit": "minute",
    "t0_iso": "2026-09-10T06:00:00+09:00",
    "horizon": 420,
    "step": 15,
    "note": "모든 window/outage 의 from,to 는 t0 로부터의 경과 분이다. 구간은 [from, to) 반열린구간이다."
  },

  "cause_labels": {
    "attack": "적대 행위에 의한 침해·거부. 침해 상태 입력(attack-timeline.json)에서만 발생한다.",
    "mobility": "기동에 의한 단절 - 지휘소 이동, 안테나 미전개, 장비 미전개.",
    "terrain": "지형에 의한 단절 - 능선 차폐, 계곡 진입, 가시선 상실.",
    "maintenance": "계획된 정비·전원 차단.",
    "unknown": "원인 미상. 공격으로 단정하지 않는다(ADR-0012 2항). 상황도에 '미상'으로 표기한다."
  },

  "geo": {
    "_role": "보조 레이어다. 기본 뷰는 임무-자산 의존성 그래프이며 지도는 토글 가능한 부가 뷰다(ADR-0001). 저하도·우선순위·색상 등급 어느 것도 이 블록을 읽지 않는다.",
    "_not_ip_geolocation": "이 블록과 asset.geo 는 자산대장 정보다. 외부 IP 지오로케이션(enrichment.geo.country)과 다른 것이고, 같은 필드에 넣지 않는다. 후자는 이벤트에 붙고 판단에 쓰지 않는다(ADR-0002).",

    "frame": {
      "id": "TACGRID-01",
      "kind": "local-plane",
      "canonical": true,
      "unit": "meter",
      "axes": {"x": "east", "y": "north", "z": "elevation_msl"},
      "extent": {"x": [0, 24000], "y": [0, 18000], "z": [0, 600]},
      "note": "정본 좌표는 이 로컬 평면 하나뿐이다. 자산마다 위경도를 따로 저장하지 않는다 - 두 표현을 각각 저장하면 어긋난다."
    },

    "georef": {
      "purpose": "로컬 평면을 지도 위젯에 올리기 위한 앵커. 표시 전용이다.",
      "datum": "WGS84",
      "epsg": 4326,
      "anchor": {"x": 0, "y": 0, "lat": 36.45, "lon": 128.5},
      "rotation_deg": 0,
      "method": "equirectangular-local",
      "formula": {
        "lat": "anchor.lat + y / 111320",
        "lon": "anchor.lon + x / (111320 * cos(anchor.lat))",
        "inverse_lat": "y = (lat - anchor.lat) * 111320",
        "inverse_lon": "x = (lon - anchor.lon) * 111320 * cos(anchor.lat)"
      },
      "approximation_error_m": 90,
      "approximation_note": "cos 를 앵커 위도에서 고정하므로 AO 북쪽 가장자리(y=18000)에서 동서 방향 최대 약 90 m 왜곡이 생긴다. 표시 레이어이므로 허용한다. 판단 로직은 로컬 평면 값만 쓴다.",
      "mgrs": {
        "store": false,
        "display": true,
        "derive_from": "wgs84",
        "gzd": "52S",
        "default_precision_digits": 8,
        "note": "MGRS 는 WGS84 datum 기반이라 위경도에서 무손실로 파생된다. 반대로 MGRS 문자열을 정본으로 저장하면 자릿수가 곧 정밀도라 값이 잘리고 격자 경계에서 보간이 깨진다. 그래서 저장은 위경도, 표시는 MGRS 로 나눈다. GZD 는 AO 전체가 UTM zone 52, 위도대 S 에 들어가서 상수다."
      }
    },

    "safety": {
      "claim": "이 시나리오의 모든 좌표는 가상이다. 실제 부대 위치·실제 군사시설·실제 지명을 쓰지 않았다.",
      "how": [
        "앵커(위도 36.45, 경도 128.5)는 한반도 내륙의 일반 산악지대를 임의로 고른 값이다. 실제 부대 배치나 실제 시설 위치에서 유도하지 않았고, 어떤 실제 편성도 참조하지 않았다.",
        "좌표를 한국으로 둔 것은 지형 감각을 맞추기 위한 것이지 특정 지역을 지목하는 것이 아니다. AO 를 다른 산악지대로 옮겨도 시나리오는 그대로 성립한다.",
        "site 라벨(여단 TOC, 능선 중계소 등)은 전부 일반명사이고 실제 지명이 아니다. 부대 이름도 여단·대대·중대 같은 제대명뿐이다.",
        "지형(terrain 블록)은 이 로컬 평면 안에서만 존재하는 창작물이다. 앵커 지점의 실제 지형과 무관하며 실제 지형에서 유도하지도 않았다.",
        "실제 시설과 우연히 가까워지더라도 이 데이터는 그 시설에 대한 정보를 담고 있지 않다. 담을 수 있는 정보가 없다 - 전부 창작이다."
      ],
      "basemap_policy": "위성영상·실지형 타일을 이 좌표에 깔고 '이 지형이 시나리오 지형'이라고 표시하지 않는다. 지도 레이어는 빈 배경 + 격자 + terrain 블록의 도식만 그린다.",
      "why_not_ocean": "초안은 앵커를 남태평양 공해에 두어 실제 시설과의 중첩 가능성을 원천 차단했다. 그러나 데모에서 지도 뷰가 빈 바다 위 격자가 되어 지형 감각을 전혀 주지 못했다. 지형 감각과 안전성을 맞바꾸는 대신, 좌표를 한반도 내륙으로 옮기고 안전성은 데이터의 성격(전부 창작, 실제 배치 미참조)과 표기로 확보한다."
    },

    "terrain": {
      "_note": "표시·서술용 도식이다. 엔진은 읽지 않는다. 가시선·차폐를 좌표에서 계산하지 않는다 - outage 의 cause 는 저작된 값이고 이 블록은 그것과 수작업으로 정합을 맞춘 그림일 뿐이다.",
      "features": [
        {"id": "TF-RIDGE-A", "kind": "ridge", "name": "북쪽 능선", "crest_elev_m": 420,
         "polyline": [[6800, 9600], [10400, 10900], [14200, 12300]]},
        {"id": "TF-VALLEY-B", "kind": "valley", "name": "동쪽 계곡", "floor_elev_m": 60,
         "polyline": [[16200, 12200], [17400, 13300], [18600, 14400]]},
        {"id": "TF-REAR", "kind": "assembly-area", "name": "후방 집결지", "elev_m": 90,
         "polygon": [[2400, 3400], [4400, 3400], [4400, 5400], [2400, 5400]]}
      ]
    },

    "position_rule": {
      "_note": "시점 t 의 자산 위치를 뽑는 결정론적 규칙. 어떤 구현이든 이 규칙만 따르면 같은 값이 나와야 한다.",
      "steps": [
        "asset.geo.kind == 'fixed' 이면 언제나 asset.geo.at 이다.",
        "asset.geo.kind == 'track' 이면 from <= t < to 인 구간을 segments 에서 찾는다. 구간은 서로 겹치지 않고 [0, timeline.horizon) 을 빈틈없이 덮는다.",
        "mode == 'hold' 이면 그 구간 내내 at 이다.",
        "mode == 'move' 이면 u = (t - from) / (to - from) 으로 at 과 to_at 을 성분별 선형보간한다. x, y, z 전부 같은 u 를 쓴다.",
        "t 가 어떤 구간에도 들어가지 않으면 위치는 0 이나 마지막 값이 아니라 미정의다. 화면에 '위치 미상'으로 표기한다(ADR-0017 의 '활성 단계 없음' 처리와 같은 태도)."
      ],
      "orthogonality": "geo 와 outages 는 직교한다. 자산이 outage 중이어도 위치는 계속 정의된다 - 미전개 장비도 어딘가에는 있다. 반대로 위치가 움직인다고 자동으로 outage 가 생기지도 않는다."
    }
  },

