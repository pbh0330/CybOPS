# 데이터셋 원본과 가공물은 저장소에 넣지 않는다 (크기 + 라이선스)
# `data/`로 디렉터리를 통째로 제외하면 Git이 그 안을 들여다보지 않아
# `!data/README.md` 예외가 동작하지 않는다. `data/*`로 내용물을 제외해야 한다.
data/*
!data/README.md

# 분석용 슬라이스는 원본에서 12분이면 재생성된다 (scripts/Export-AuthRedteamSlice.ps1).
# 요약 JSON은 커밋하고 대용량 CSV는 제외한다.
analysis/**/*.csv

# 모델 가중치, 인덱스
models/
*.gguf
*.safetensors
.chroma/
*.faiss

# 비밀값
.env
.env.*
!.env.example
configs/*.local.yaml
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
build/

# OS / 에디터
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# Claude Code 로컬 설정
.claude/settings.local.json
CLAUDE.local.md

# 무인 실행 로그는 계속 자란다. 결과 JSON만 커밋한다.
analysis/overnight*.log
analysis/ollama-pull-*.log
analysis/ollama-pull-*.log.err
analysis/briefing/compare/
analysis/lanl/auth-features.csv

# 진행 로그(중간 산출물)
analysis/lanl/_features.log
analysis/optc/_host-index.log
analysis/lanl/auth-features2.csv
analysis/lanl/auth-features2-n100.csv
analysis/lanl/_e1a-*.log
analysis/lanl/_features2*.log

# 사용자가 둔 문서. 커밋 여부는 사용자가 정한다.
프로젝트 수행 계획서.pdf
프로젝트 수행계획서_MC-CyCOP.docx
프로젝트 수행계획서_MC-CyCOP.pdf
analysis/optc/ecar-windows-*.csv
analysis/optc/_ecar-windows-*.log
analysis/briefing/_v3-*.log

# 콘솔 로그. 결과는 eval/results 의 JSON 에 있고 이것은 실행 흔적일 뿐이다.
analysis/logs/

# 호스팅용 산출물. Publish-Briefings.ps1 + Test-BundleConfig.ps1 로 다시 만들 수 있다.
ui/dist-hosted/
ui/mc-cycop-hosted.zip

# 발행 경로의 중간 산출물. 시도별 브리핑과 검사 보고서는 재생성된다.
# 발행된 것은 ui/public/data 와 eval/results/briefing-publish.json 에 남는다.
analysis/briefing/publish/

# 재라벨 전 원본 특징 CSV 백업. relabel_ecar_windows.py 가 남긴다.
analysis/**/*.csv.bak

# 예외: Inria 수정판 그라운드트루스는 95KB, CC BY 4.0(재배포 가능)이고
# 이것 없이는 E1-b 라벨을 재생성할 수 없다. docs/01-datasets.md 참고.
!analysis/optc/inria/*.csv

# 이전 추출의 사이드카. 수치는 docs/19 13절 표와 git 이력에 있다.
analysis/**/*.v1.summary.json
